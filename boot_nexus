07-bootloader.sh — Rendre bootable

```bash
#!/usr/bin/env bash
# 07-bootloader.sh — installe GRUB sur le disque cible
set -euo pipefail

NEXUS_ROOT="/mnt/nexus"
DISK="/dev/sdX" # ⚠️ REMPLACE par ton disque cible (ex: /dev/sda)

echo "=== [7/9] Installation du bootloader sur $DISK ==="

# 7.1 Monter les pseudo-systèmes pour chroot
mount --bind /dev "$NEXUS_ROOT/dev"
mount --bind /proc "$NEXUS_ROOT/proc"
mount --bind /sys "$NEXUS_ROOT/sys"

# 7.2 Installer GRUB dans le chroot
chroot "$NEXUS_ROOT" /bin/bash -c "
grub-install --target=i386-pc $DISK &&
grub-mkconfig -o /boot/grub/grub.cfg
"

# 7.3 Démonter proprement
umount "$NEXUS_ROOT/dev" "$NEXUS_ROOT/proc" "$NEXUS_ROOT/sys"

echo "[OK] Système bootable sur $DISK."
```

