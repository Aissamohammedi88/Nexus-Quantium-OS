# 4.1 Vérifier que la partition est montée
if ! mountpoint -q "$NEXUS_ROOT"; then
echo "Monte d'abord ta partition cible sur $NEXUS_ROOT"
exit 1
fi

# 4.2 Créer l'arborescence FHS minimale
mkdir -pv "$NEXUS_ROOT"/{etc,var,usr,bin,lib,sbin,tmp,home,root,opt,proc,sys,dev,run}
mkdir -pv "$NEXUS_ROOT"/usr/{bin,lib,sbin,include,share}
mkdir -pv "$NEXUS_ROOT"/var/{log,lib,tmp}
ln -sv usr/bin "$NEXUS_ROOT/bin"
ln -sv usr/lib "$NEXUS_ROOT/lib"
ln -sv usr/sbin "$NEXUS_ROOT/sbin"
chmod 1777 "$NEXUS_ROOT/tmp"

# 4.3 Créer l'utilisateur lfs pour la phase chroot
groupadd -f lfs || true
useradd -s /bin/bash -g lfs -m -k /dev/null lfs 2>/dev/null || true
chown -v lfs:lfs "$NEXUS_ROOT"
chown -v lfs:lfs "$LFS"

# 4.4 Passer la main à l'utilisateur lfs
echo "[INFO] La suite doit être exécutée en tant qu'utilisateur 'lfs'."
echo " Suis les chapitres 5 à 8 du manuel LFS-BOOK.pdf."
echo " Chaque paquet = ./configure + make + make install, dans l'ordre."
echo "[OK] Arborescence préparée."
```

