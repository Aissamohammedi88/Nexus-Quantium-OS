08-package-iso.sh — Générer l’ISO Nexus OS

```bash
#!/usr/bin/env bash
# 08-package-iso.sh — packager Nexus OS en ISO bootable
set -euo pipefail

NEXUS_ROOT="/mnt/nexus"
OUT="$HOME/nexus-build/iso"
mkdir -p "$OUT"/{boot/grub,isolinux,Nexus}

echo "=== [8/9] Packaging ISO ==="

# 8.1 Copier noyau + initrd
cp "$NEXUS_ROOT/boot/vmlinuz"* "$OUT/boot/" || true
cp "$NEXUS_ROOT/boot/initrd"* "$OUT/boot/" || true

# 8.2 Créer le rootfs squashfs
mksquashfs "$NEXUS_ROOT" "$OUT/Nexus/rootfs.squashfs" -comp xz -noappend

# 8.3 Config GRUB pour l'ISO
cat > "$OUT/boot/grub/grub.cfg" <<'EOF'
set default=0
set timeout=5
menuentry "Nexus OS 1.0 (Omega)" {
linux /boot/vmlinuz root=/dev/ram0 rw quiet
initrd /boot/initrd.img
}
EOF

# 8.4 Construire l'ISO
grub-mkrescue -o "$OUT/nexus-os.iso" "$OUT"

echo "[OK] ISO générée : $OUT/nexus-os.iso"
```

