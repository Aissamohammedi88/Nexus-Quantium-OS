ARCH_ISO_URL="https://mirror.rackspace.com/archlinux/iso/latest/archlinux-x86_64.iso"



mkdir -p "${WORK_DIR}" "${ISO_DIR}"

exec > >(tee -a "${LOG_FILE}") 2>&1



