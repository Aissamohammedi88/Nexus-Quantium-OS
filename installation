# Crée une clé USB bootable contenant NixOS + Arch Linux fusionnés

# avec un menu de démarrage Nexus personnalisé (GRUB)

#

# Auteur : Aissa Mohammedi (DGK)

#

# ⚠️  ATTENTION : Ce script ÉCRIT sur un disque. Vérifie 2x le device !

# ═══════════════════════════════════════════════════════════════════════════



set -euo pipefail



# ═══════════════════════════════════════════════════════════════════

# COULEURS

# ═══════════════════════════════════════════════════════════════════

G='\033[92m'; Y='\033[93m'; R='\033[91m'; C='\033[96m'; M='\033[95m'; B='\033[1m'; N='\033[0m'

info()  { echo -e "${G}[✅]${N} $*"; }

warn()  { echo -e "${Y}[⚠️ ]${N} $*"; }

err()   { echo -e "${R}[❌]${N} $*"; }

sec()   { echo -e "\n${C}${B}═══ $* ═══${N}\n"; }



# ═══════════════════════════════════════════════════════════════════

# CONFIG

# ═══════════════════════════════════════════════════════════════════

WORK_DIR="${HOME}/nexus_os_build"

ISO_DIR="${WORK_DIR}/isos"

USB_MNT="${WORK_DIR}/usb_mnt"

