finaliser() {

    sec "FINALISATION"



    info "Synchronisation des écritures..."

    sync

    sleep 2



    info "Démontage des partitions..."

    umount "${USB_MNT}/boot"  2>/dev/null || true

    umount "${USB_MNT}/nixos" 2>/dev/null || true

    umount "${USB_MNT}/arch"  2>/dev/null || true

    umount "${USB_MNT}/data"  2>/dev/null || true



    rmdir "${USB_MNT}"/* 2>/dev/null || true

    rmdir "${USB_MNT}"   2>/dev/null || true



    info "Clé USB prête à être retirée"

}



