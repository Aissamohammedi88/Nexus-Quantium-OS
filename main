4. Mesh Agent — Go

go.mod

```go
// /opt/nexus/mesh/go.mod
module nexus-mesh
go 1.22
```

main.go

```go
// /opt/nexus/mesh/main.go
package main

import (
"encoding/json"
"log"
"net/http"
"sync"
"time"
)

type heartbeat struct {
Agent string `json:"agent"`
Status string `json:"status"`
LastSee time.Time `json:"last_seen"`
}

var (
mu sync.Mutex
agents = map[string]heartbeat{}
)

func register(w http.ResponseWriter, r *http.Request) {
var hb heartbeat
if err := json.NewDecoder(r.Body).Decode(&hb); err != nil {
http.Error(w, "bad json", 400)
return
}
hb.LastSee = time.Now()
mu.Lock(); agents[hb.Agent] = hb; mu.Unlock()
w.WriteHeader(200)
_ = json.NewEncoder(w).Encode(map[string]string{"status": "ok"})
}

func list(w http.ResponseWriter, r *http.Request) {
mu.Lock(); defer mu.Unlock()
_ = json.NewEncoder(w).Encode(agents)
}

func health(w http.ResponseWriter, r *http.Request) {
_ = json.NewEncoder(w).Encode(map[string]string{"status": "ok", "agent": "nexus-mesh"})
}

func main() {
http.HandleFunc("/register", register)
http.HandleFunc("/agents", list)
http.HandleFunc("/health", health)
log.Println("Nexus Mesh Agent on :9100")
log.Fatal(http.ListenAndServe(":9100", nil))
}
```

Build

```bash
cd /opt/nexus/mesh
go build -o nexus-mesh .
sudo cp nexus-mesh /usr/local/bin/nexus-mesh
```

