3. Brain Agent — Python (FastAPI + Omega)

requirements.txt

```txt
# /opt/nexus/brain/requirements.txt
fastapi==0.115.0
uvicorn[standard]==0.32.0
pydantic==2.9.2
httpx==0.27.2
```

resonance_core.py — ton API Omega (recopié)

```python
# /opt/nexus/brain/resonance_core.py
# (ton code APIOmega complet, sans modification)
```

main.py

```python
# /opt/nexus/brain/main.py
import json
import logging
from fastapi import FastAPI
from pydantic import BaseModel
from typing import Any, Dict
import resonance_core

logging.basicConfig(level=logging.INFO)
log = logging.getLogger("nexus-brain")

app = FastAPI(title="Nexus Brain Agent")
omega = resonance_core.APIOmega()

class Signal(BaseModel):
source: str
payload: Dict[str, Any]

class Decision(BaseModel):
action: str
target: str
reason: str
confidence: float
approved: bool

def analyse_signal(sig: Signal) -> Decision:
p = sig.payload
cpu = float(p.get("cpu_usage_avg", 0))
mem_used = float(p.get("mem_used_mb", 0))
mem_total = max(float(p.get("mem_total_mb", 1)), 1)
mem_pct = mem_used / mem_total * 100

if cpu > 90.0:
return Decision(
action="warn", target="cpu",
reason=f"CPU usage critique: {cpu:.1f}%",
confidence=0.9, approved=True,
)
if mem_pct > 90.0:
return Decision(
action="warn", target="memory",
reason=f"Mémoire critique: {mem_pct:.1f}%",
confidence=0.9, approved=True,
)
return Decision(
action="noop", target="system",
reason="Système stable", confidence=0.5, approved=False,
)

@app.post("/decide", response_model=Decision)
async def decide(sig: Signal) -> Decision:
token = omega.generer_token("nexus-brain", sig.source)
resp = omega.executer_requete(token, json.dumps(sig.payload))
log.info("omega: %s", resp)

d = analyse_signal(sig)
log.info("decision: %s", d)
return d

@app.get("/health")
async def health():
return {"status": "ok", "agent": "nexus-brain"}
```

Lancement

```bash
cd /opt/nexus/brain
python3 -m venv venv && source venv/bin/activate
pip install -r requirements.txt
uvicorn main:app --host 127.0.0.1 --port 8000
```

