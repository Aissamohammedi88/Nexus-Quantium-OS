5. Exec Agent — Bash (whitelist d’actions)

```bash
#!/usr/bin/env bash
# /opt/nexus/exec/nexus-exec.sh
# Reçoit un JSON {"action":"...","target":"..."} et exécute UNIQUEMENT
# les actions dans la whitelist. Logge tout dans /opt/nexus/logs/exec.log.
set -euo pipefail

LOG=/opt/nexus/logs/exec.log
mkdir -p "$(dirname "$LOG")"

ORDER="${1:-}"
[[ -z "$ORDER" ]] && { echo "usage: $0 '<json>'"; exit 1; }

ACTION=$(echo "$ORDER" | python3 -c 'import sys,json;print(json.load(sys.stdin)["action"])')
TARGET=$(echo "$ORDER" | python3 -c 'import sys,json;print(json.load(sys.stdin)["target"])')

# Whitelist stricte
case "$ACTION" in
warn)
echo "$(date -Is) WARN target=$TARGET" | tee -a "$LOG"
;;
restart)
case "$TARGET" in
ssh|NetworkManager|nexus-omega|nexus-brain)
systemctl restart "$TARGET" 2>&1 | tee -a "$LOG"
;;
*) echo "$(date -Is) REFUSED restart $TARGET" | tee -a "$LOG"; exit 2 ;;
esac
;;
stop)
case "$TARGET" in
ssh|NetworkManager|nexus-omega|nexus-brain)
systemctl stop "$TARGET" 2>&1 | tee -a "$LOG"
;;
*) echo "$(date -Is) REFUSED stop $TARGET" | tee -a "$LOG"; exit 2 ;;
esac
;;
noop)
echo "$(date -Is) NOOP" | tee -a "$LOG"
;;
*)
echo "$(date -Is) UNKNOWN action=$ACTION" | tee -a "$LOG"; exit 3
;;
esac
```

```bash
chmod +x /opt/nexus/exec/nexus-exec.sh
```

