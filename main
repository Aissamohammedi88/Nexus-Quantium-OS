2. Core Agent — Rust

Cargo.toml

```toml
# /opt/nexus/core/Cargo.toml
[package]
name = "nexus-core"
version = "1.0.0"
edition = "2021"

[dependencies]
tokio = { version = "1", features = ["full"] }
reqwest = { version = "0.12", features = ["json"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
sysinfo = "0.32"
tracing = "0.1"
tracing-subscriber = "0.3"
```

src/main.rs

```rust
// /opt/nexus/core/src/main.rs
use serde::{Deserialize, Serialize};
use std::time::Duration;
use sysinfo::System;
use tokio::time::sleep;

#[derive(Serialize, Deserialize, Debug)]
struct Signal {
source: String,
payload: serde_json::Value,
}

#[derive(Serialize, Deserialize, Debug)]
struct Decision {
action: String,
target: String,
reason: String,
confidence: f32,
approved: bool,
}

const BRAIN_URL: &str = "http://127.0.0.1:8000/decide";
const EXEC_BIN: &str = "/opt/nexus/exec/nexus-exec.sh";

async fn collect_system() -> serde_json::Value {
let mut sys = System::new_all();
sys.refresh_all();
serde_json::json!({
"cpu_count": sys.cpus().len(),
"cpu_usage_avg": sys.cpus().iter().map(|c| c.cpu_usage()).sum::<f32>() / sys.cpus().len() as f32,
"mem_total_mb": sys.total_memory() / 1024 / 1024,
"mem_used_mb": sys.used_memory() / 1024 / 1024,
"uptime_s": System::uptime(),
})
}

async fn send_to_brain(client: &reqwest::Client, signal: &Signal) -> Option<Decision> {
match client.post(BRAIN_URL).json(signal).send().await {
Ok(resp) => resp.json::<Decision>().await.ok(),
Err(e) => { tracing::warn!("brain unreachable: {e}"); None }
}
}

async fn exec_decision(decision: &Decision) {
if !decision.approved {
tracing::info!("decision non approuvée, skip: {:?}", decision);
return;
}
let order = serde_json::json!({
"action": decision.action,
"target": decision.target
});
match tokio::process::Command::new(EXEC_BIN)
.arg(order.to_string())
.output()
.await
{
Ok(out) => tracing::info!(
"exec: {:?} | code={:?}",
decision.action,
out.status.code()
),
Err(e) => tracing::error!("exec fail: {e}"),
}
}

#[tokio::main]
async fn main() {
tracing_subscriber::fmt::init();
tracing::info!("Nexus Core Agent starting");

let client = reqwest::Client::builder()
.timeout(Duration::from_secs(5))
.build()
.expect("http client");

loop {
let sys = collect_system().await;
let signal = Signal {
source: "core".into(),
payload: sys,
};
tracing::debug!("signal: {:?}", signal);

if let Some(decision) = send_to_brain(&client, &signal).await {
tracing::info!("decision: {:?}", decision);
exec_decision(&decision).await;
}

sleep(Duration::from_secs(10)).await;
}
}
```

Build

```bash
cd /opt/nexus/core
cargo build --release
sudo cp target/release/nexus-core /usr/local/bin/nexus-core
```

