
0. Arborescence cible sur ton OS

```bash
sudo mkdir -p /opt/nexus/{core,brain,mesh,exec,logs,config}
sudo chown -R $USER:$USER /opt/nexus
```

```
/opt/nexus/
├── core/ # Rust daemon
├── brain/ # Python FastAPI
├── mesh/ # Go orchestrator
├── exec/ # Bash exec
├── logs/ # audit
└── config/ # configs
```

---

1. Schéma SQL (base nexus_agents)

```sql
-- /opt/nexus/config/schema.sql
CREATE DATABASE IF NOT EXISTS nexus_agents
CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

USE nexus_agents;

CREATE TABLE IF NOT EXISTS signals (
id BIGINT AUTO_INCREMENT PRIMARY KEY,
source VARCHAR(64) NOT NULL,
payload JSON NOT NULL,
created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
INDEX idx_source_time (source, created_at)
);

CREATE TABLE IF NOT EXISTS decisions (
id BIGINT AUTO_INCREMENT PRIMARY KEY,
signal_id BIGINT,
agent VARCHAR(64) NOT NULL,
intention VARCHAR(128),
action VARCHAR(64),
target VARCHAR(255),
reason TEXT,
confidence FLOAT,
approved BOOLEAN DEFAULT FALSE,
created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
FOREIGN KEY (signal_id) REFERENCES signals(id) ON DELETE SET NULL,
INDEX idx_agent_time (agent, created_at)
);

CREATE TABLE IF NOT EXISTS actions (
id BIGINT AUTO_INCREMENT PRIMARY KEY,
decision_id BIGINT,
command TEXT NOT NULL,
exit_code INT,
stdout TEXT,
stderr TEXT,
duration_ms INT,
executed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
FOREIGN KEY (decision_id) REFERENCES decisions(id) ON DELETE SET NULL,
INDEX idx_exec_time (executed_at)
);

CREATE TABLE IF NOT EXISTS agents_heartbeat (
agent VARCHAR(64) PRIMARY KEY,
last_seen TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
version VARCHAR(32),
status VARCHAR(32) DEFAULT 'alive'
);
```

```bash
mysql -u root -p < /opt/nexus/config/schema.sql
```

